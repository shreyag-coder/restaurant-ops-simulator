{
  "schema_version": 1,
  "name": "Lunch rush",
  "target": {
    "orders": 10,
    "deadline": 30,
    "description": "Complete all 10 orders correctly within 30 simulated minutes."
  },
  "orders": [
    {"id": "O1",  "arrival": 0,  "deadline": 12, "items": [{"recipe": "burger", "quantity": 1, "modifiers": []},             {"recipe": "fries", "quantity": 1, "modifiers": []}]},
    {"id": "O2",  "arrival": 0,  "deadline": 14, "items": [{"recipe": "burger", "quantity": 2, "modifiers": ["no_lettuce"]}, {"recipe": "fries", "quantity": 1, "modifiers": []}]},
    {"id": "O3",  "arrival": 1,  "deadline": 16, "items": [{"recipe": "burger", "quantity": 1, "modifiers": ["extra_cheese"]}]},
    {"id": "O4",  "arrival": 2,  "deadline": 15, "items": [{"recipe": "fries",  "quantity": 2, "modifiers": []}]},
    {"id": "O5",  "arrival": 3,  "deadline": 18, "items": [{"recipe": "burger", "quantity": 1, "modifiers": ["no_cheese"]},  {"recipe": "fries", "quantity": 1, "modifiers": []}]},
    {"id": "O6",  "arrival": 6,  "deadline": 22, "items": [{"recipe": "fries",  "quantity": 1, "modifiers": []}]},
    {"id": "O7",  "arrival": 8,  "deadline": 24, "items": [{"recipe": "fries",  "quantity": 1, "modifiers": []}]},
    {"id": "O8",  "arrival": 10, "deadline": 26, "items": [{"recipe": "burger", "quantity": 1, "modifiers": []},             {"recipe": "burger", "quantity": 1, "modifiers": ["no_cheese", "no_lettuce"]}]},
    {"id": "O9",  "arrival": 12, "deadline": 28, "items": [{"recipe": "fries",  "quantity": 1, "modifiers": []}]},
    {"id": "O10", "arrival": 14, "deadline": 30, "items": [{"recipe": "fries",  "quantity": 1, "modifiers": []}]}
  ],
  "variants": {
    "baseline": {
      "description": "All four workers stay available for the whole run."
    },
    "disruption": {
      "description": "The grill cook becomes unavailable at minute 5; the expediter is the qualified grill backup.",
      "events": [{"tick": 5, "type": "worker_unavailable", "worker_id": "w_grill"}]
    },
    "blocker": {
      "description": "Same disruption, but the expediter has no grill skill, so remaining grill work is blocked.",
      "worker_overrides": {"w_expo": {"remove_skills": ["grill"]}},
      "events": [{"tick": 5, "type": "worker_unavailable", "worker_id": "w_grill"}],
      "expected_missing_skills": ["grill"]
    }
  }
}
